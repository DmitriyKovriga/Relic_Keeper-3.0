  - m_Id: 102777508791984128
    m_Localized: "\u041A\u0430\u0437\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 102777508833927168
    m_Localized: "\u0423\u0434\u0430\u0440 \u043A\u0438\u043D\u0436\u0430\u043B\u043E\u043C
      \u043F\u0435\u0440\u0435\u0434 \u0441\u043E\u0431\u043E\u0439. \u042D\u0442\u043E
      \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435 \u0434\u0430\u0451\u0442
      +10% \u043A \u043F\u043E\u0440\u043E\u0433\u0443 \u043A\u0430\u0437\u043D\u0438
      \u0432 \u0434\u043E\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0435 \u043A
      \u044D\u043A\u0438\u043F\u0438\u0440\u043E\u0432\u043A\u0435. \u0412\u0440\u0430\u0433\u0438,
      \u0447\u044C\u0451 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435 \u043F\u043E\u0441\u043B\u0435
      \u0443\u0434\u0430\u0440\u0430 \u043D\u0438\u0436\u0435 \u043F\u043E\u0440\u043E\u0433\u0430,
      \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u043E \u043F\u043E\u0433\u0438\u0431\u0430\u044E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 103099397276049408
    m_Localized: "\u0418\u0437\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 103099397317992448
    m_Localized: "\u0417\u0430\u0446\u0435\u043F\u0438\u0442\u0435 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u0433\u043E
      \u0432\u0440\u0430\u0433\u0430 \u043F\u0435\u0440\u0435\u0434 \u0441\u043E\u0431\u043E\u0439
      \u0442\u043E\u043F\u043E\u0440\u043E\u043C \u0438 \u0432\u044B\u0440\u0432\u0438\u0442\u0435
      \u043B\u0435\u0437\u0432\u0438\u0435 \u0438\u0437 \u0440\u0430\u043D\u044B.
      \u042D\u0442\u043E\u0442 \u0443\u0434\u0430\u0440 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442
      +100% \u043A \u0448\u0430\u043D\u0441\u0443 \u0438\u0437\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u044F
      \u043A\u0440\u043E\u0432\u043E\u0442\u0435\u0447\u0435\u043D\u0438\u044F. \u0418\u0437\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u0435
      \u0440\u0430\u0441\u0445\u043E\u0434\u0443\u0435\u0442 \u0441\u0438\u043B\u044C\u043D\u0435\u0439\u0448\u0435\u0435
      \u0441\u0442\u0430\u0440\u043E\u0435 \u043A\u0440\u043E\u0432\u043E\u0442\u0435\u0447\u0435\u043D\u0438\u0435
      \u0438 \u043D\u0430\u043D\u043E\u0441\u0438\u0442 \u0447\u0430\u0441\u0442\u044C
      \u043E\u0441\u0442\u0430\u0432\u0448\u0435\u0433\u043E\u0441\u044F \u0443\u0440\u043E\u043D\u0430
      \u0432 \u0440\u0430\u0437\u043C\u0435\u0440\u0435 \xAB\u0418\u0437\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u044F
      \u043A\u0440\u043E\u0432\u043E\u0442\u0435\u0447\u0435\u043D\u0438\u044F\xBB.
      \u042D\u0442\u043E\u0442 \u0443\u0440\u043E\u043D \u043D\u0435 \u043C\u043E\u0436\u0435\u0442
      \u0431\u044B\u0442\u044C \u043A\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u043C
      \u0438\u043B\u0438 \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0442\u044C
      \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u044F. \u0421\u0430\u043C
      \u0443\u0434\u0430\u0440 \u043C\u043E\u0436\u0435\u0442 \u043D\u0430\u043B\u043E\u0436\u0438\u0442\u044C
      \u043D\u043E\u0432\u043E\u0435 \u043A\u0440\u043E\u0432\u043E\u0442\u0435\u0447\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 103123438414209024
    m_Localized: "\u041F\u0430\u0434\u0430\u044E\u0449\u0430\u044F \u043D\u0430\u043A\u043E\u0432\u0430\u043B\u044C\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 103123438460346368
    m_Localized: "\u0422\u044F\u0436\u0451\u043B\u044B\u0439 \u0443\u0434\u0430\u0440
      \u043C\u043E\u043B\u043E\u0442\u043E\u043C. \u0412 \u0432\u043E\u0437\u0434\u0443\u0445\u0435
      \u0433\u0435\u0440\u043E\u0439 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442
      \u043C\u043E\u043B\u043E\u0442 \u0432\u043D\u0438\u0437 \u0438 \u0431\u044C\u0451\u0442
      \u043F\u0440\u0438 \u043F\u0440\u0438\u0437\u0435\u043C\u043B\u0435\u043D\u0438\u0438.
      \u0412\u044B\u0441\u043E\u0442\u0430 \u043F\u0430\u0434\u0435\u043D\u0438\u044F
      \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u0443\u0440\u043E\u043D
      \u0434\u043E \u043F\u0440\u0435\u0434\u0435\u043B\u0430. \u0421\u0438\u043B\u0430
      \u043F\u0440\u044B\u0436\u043A\u0430 \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442
      \u043D\u0430\u0431\u0440\u0430\u0442\u044C \u0432\u044B\u0441\u043E\u0442\u0443,
      \u0430 \u043E\u0431\u043B\u0430\u0441\u0442\u044C \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F
      \u0440\u0430\u0441\u0448\u0438\u0440\u044F\u0435\u0442 \u0443\u0434\u0430\u0440.
      \u0412\u043E \u0432\u0440\u0435\u043C\u044F \u043F\u0430\u0434\u0435\u043D\u0438\u044F
      \u0433\u0435\u0440\u043E\u0439 \u0443\u044F\u0437\u0432\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 103128754073772032
    m_Localized: "\u0423\u0434\u0430\u0447\u043D\u044B\u0439 \u0432\u044B\u0441\u0442\u0440\u0435\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 103128754115715072
    m_Localized: "\u0412\u044B\u043F\u0443\u0441\u043A\u0430\u0435\u0442 \u0441\u0442\u0440\u0435\u043B\u0443,
      \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043E\u0442\u0441\u043A\u0430\u043A\u0438\u0432\u0430\u0435\u0442
      \u043E\u0442 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0435\u0439
      \u0438 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u043A \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u043C\u0443 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E\u043C\u0443
      \u0432\u0440\u0430\u0433\u0443. \u0420\u0438\u043A\u043E\u0448\u0435\u0442
      \u0443\u0441\u0438\u043B\u0438\u0432\u0430\u0435\u0442 \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435.
      \u0426\u0435\u043F\u044C \u0441\u043D\u0430\u0440\u044F\u0434\u043E\u0432 \u0434\u0430\u0451\u0442
      \u043E\u0442\u0441\u043A\u043E\u043A\u0438 \u043E\u0442 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0435\u0439
      \u0432\u043C\u0435\u0441\u0442\u043E \u0446\u0435\u043F\u0438 \u043C\u0435\u0436\u0434\u0443
      \u0432\u0440\u0430\u0433\u0430\u043C\u0438; \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C
      \u0441\u043D\u0430\u0440\u044F\u0434\u043E\u0432 \u0441\u043E\u043A\u0440\u0430\u0449\u0430\u0435\u0442
      \u0432\u0440\u0435\u043C\u044F \u043F\u043E\u043B\u0451\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 103135056044892160
    m_Localized: "\u0413\u0440\u043E\u043C\u043E\u043E\u0442\u0432\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 103135056091029504
    m_Localized: "\u0421\u043E\u0437\u0434\u0430\u0451\u0442 \u0434\u0432\u0430 \u043D\u0435\u043F\u043E\u0434\u0432\u0438\u0436\u043D\u044B\u0445
      \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u0434\u0430. \u0420\u0430\u0437\u0440\u044F\u0434
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0440\u0430\u0437 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
      \u043C\u0435\u0436\u0434\u0443 \u043D\u0438\u043C\u0438, \u043F\u043E\u0440\u0430\u0436\u0430\u044F
      \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0432\u0440\u0430\u0433\u0430 \u043D\u0430
      \u043B\u0438\u043D\u0438\u0438 \u043E\u0434\u0438\u043D \u0440\u0430\u0437
      \u0437\u0430 \u043F\u0440\u043E\u0445\u043E\u0434. \u0423\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435
      \u0432\u0440\u0430\u0433\u043E\u0432 \u043C\u0435\u0436\u0434\u0443 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u0434\u0430\u043C\u0438.
      \u041E\u0431\u043B\u0430\u0441\u0442\u044C \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F
      \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0435
      \u043C\u0435\u0436\u0434\u0443 \u043D\u0438\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 103147147069890560
    m_Localized: "\u041B\u0435\u0434\u044F\u043D\u0430\u044F \u0441\u0442\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 103147147120222208
    m_Localized: "\u0421\u043E\u0437\u0434\u0430\u0451\u0442 \u043B\u0435\u0434\u044F\u043D\u0443\u044E
      \u0441\u0442\u0435\u043D\u0443 \u043F\u0435\u0440\u0435\u0434 \u0433\u0435\u0440\u043E\u0435\u043C:
      \u043F\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u0435\u0442
      \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u0435 \u0430\u0442\u0430\u043A\u0438
      \u0438 \u0441\u043D\u0430\u0440\u044F\u0434\u044B \u0438 \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442
      \u043B\u0435\u0434\u044F\u043D\u044B\u043C\u0438 \u043E\u0441\u043A\u043E\u043B\u043A\u0430\u043C\u0438
      \u043D\u0430 \u043E\u0441\u043D\u043E\u0432\u0435 \u0443\u0440\u043E\u043D\u0430
      \u043E\u0440\u0443\u0436\u0438\u044F \u0432 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0439
      \u0440\u0443\u043A\u0435. \u0420\u0430\u0441\u0445\u043E\u0434\u0443\u0435\u0442
      \u043E\u0434\u0438\u043D \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B\u0439
      \u0437\u0430\u0440\u044F\u0434 \u041C\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
      \u0449\u0438\u0442\u0430, \u0443\u0441\u0438\u043B\u0438\u0432\u0430\u044F
      \u0443\u0440\u043E\u043D \u0438 \u0434\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 103151794727821312
    m_Localized: "\u0411\u0430\u0433\u0440\u043E\u0432\u044B\u0439 \u043A\u0440\u044E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 103151794769764352
    m_Localized: "\u0414\u0430\u043B\u044C\u043D\u0438\u0439 \u0437\u0430\u0445\u0432\u0430\u0442
      \u043F\u043E\u0440\u0430\u0436\u0430\u0435\u0442 \u0432\u0440\u0430\u0433\u043E\u0432
      \u043F\u0435\u0440\u0435\u0434 \u0433\u0435\u0440\u043E\u0435\u043C \u0438
      \u043F\u0440\u0438\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442 \u043F\u043E\u0434\u0432\u0438\u0436\u043D\u044B\u0435
      \u0446\u0435\u043B\u0438. \u0422\u044F\u0436\u0451\u043B\u044B\u0435 \u0438
      \u043D\u0435\u043F\u043E\u0434\u0432\u0438\u0436\u043D\u044B\u0435 \u0432\u0440\u0430\u0433\u0438
      \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442 \u0443\u0440\u043E\u043D \u0431\u0435\u0437
      \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u044F. \u041E\u0431\u043B\u0430\u0441\u0442\u044C
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442
      \u0448\u0438\u0440\u0438\u043D\u0443 \u0437\u0430\u0445\u0432\u0430\u0442\u0430,
      \u043F\u043E\u043C\u043E\u0433\u0430\u044F \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C
      \u0433\u0440\u0443\u043F\u043F\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 103203139270877184
    m_Localized: "\u041F\u0440\u0438\u0437\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u0446\u0438\u043A\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 103203139358957568
    m_Localized: "\u0412\u044B\u0441\u0442\u0440\u0435\u043B\u044B \u0447\u0435\u0440\u0435\u0434\u0443\u044E\u0442
      \u043E\u0433\u043E\u043D\u044C, \u0445\u043E\u043B\u043E\u0434 \u0438 \u043C\u043E\u043B\u043D\u0438\u044E,
      \u043F\u0440\u0435\u043E\u0431\u0440\u0430\u0437\u0443\u044F \u0432\u0435\u0441\u044C
      \u0443\u0440\u043E\u043D \u043E\u0440\u0443\u0436\u0438\u044F \u0432 \u0442\u0435\u043A\u0443\u0449\u0443\u044E
      \u0441\u0442\u0438\u0445\u0438\u044E. \u041A\u0430\u0436\u0434\u043E\u0435
      \u0447\u0435\u0442\u0432\u0451\u0440\u0442\u043E\u0435 \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435
      \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u0435\u0442 \u043F\u0440\u0438\u0437\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u0437\u0430\u043B\u043F: \u0443\u0440\u043E\u043D \u043F\u043E\u0440\u043E\u0432\u043D\u0443
      \u0440\u0430\u0437\u0434\u0435\u043B\u0451\u043D \u043C\u0435\u0436\u0434\u0443
      \u0442\u0440\u0435\u043C\u044F \u0441\u0442\u0438\u0445\u0438\u044F\u043C\u0438,
      \u043D\u0430 100% \u0431\u043E\u043B\u044C\u0448\u0435 \u0443\u0440\u043E\u043D\u0430
      \u043E\u0442 \u0447\u0430\u0440. \u0426\u0438\u043A\u043B \u0441\u0447\u0438\u0442\u0430\u0435\u0442
      \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u044F, \u0430 \u043D\u0435
      \u0441\u043D\u0430\u0440\u044F\u0434\u044B \u0438\u043B\u0438 \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 103407469831790592
    m_Localized: "\u0422\u0435\u043A\u0442\u043E\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u043F\u0440\u0435\u0441\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 103407469873733632
    m_Localized: "\u0423\u0434\u0430\u0440 \u043D\u0430\u043D\u043E\u0441\u0438\u0442
      250% \u0443\u0440\u043E\u043D\u0430 \u043E\u0440\u0443\u0436\u0438\u044F \u0438
      \u0441\u0438\u043B\u044C\u043D\u043E \u043E\u0442\u0442\u0430\u043B\u043A\u0438\u0432\u0430\u0435\u0442
      \u0432\u0440\u0430\u0433\u043E\u0432. \u041F\u0440\u0438 \u0441\u0442\u043E\u043B\u043A\u043D\u043E\u0432\u0435\u043D\u0438\u0438
      \u043E\u0442\u0431\u0440\u043E\u0448\u0435\u043D\u043D\u043E\u0439 \u0446\u0435\u043B\u0438
      \u0441\u043E \u0441\u0442\u0435\u043D\u043E\u0439 \u0438\u043B\u0438 \u0434\u0440\u0443\u0433\u0438\u043C
      \u0432\u0440\u0430\u0433\u043E\u043C \u0432\u043E\u0437\u043D\u0438\u043A\u0430\u0435\u0442
      \u0443\u0434\u0430\u0440\u043D\u0430\u044F \u0432\u043E\u043B\u043D\u0430 \u0441
      200% \u0443\u0440\u043E\u043D\u0430 \u043E\u0440\u0443\u0436\u0438\u044F. \u041A\u0430\u0436\u0434\u0430\u044F
      \u043E\u0442\u0431\u0440\u043E\u0448\u0435\u043D\u043D\u0430\u044F \u0446\u0435\u043B\u044C
      \u0441\u043E\u0437\u0434\u0430\u0451\u0442 \u043D\u0435 \u0431\u043E\u043B\u0435\u0435
      \u043E\u0434\u043D\u043E\u0439 \u0432\u043E\u043B\u043D\u044B. \u041E\u0442\u0442\u0430\u043B\u043A\u0438\u0432\u0430\u043D\u0438\u0435
      \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      \u0442\u043E\u043B\u0447\u043A\u0430, \u043E\u0431\u043B\u0430\u0441\u0442\u044C
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u2014 \u0440\u0430\u0434\u0438\u0443\u0441
      \u0441\u0442\u043E\u043B\u043A\u043D\u043E\u0432\u0435\u043D\u0438\u044F \u0438
      \u0432\u043E\u043B\u043D\u044B. \u0423\u0440\u043E\u043D \u0443\u0434\u0430\u0440\u043D\u043E\u0439
      \u0432\u043E\u043B\u043D\u044B \u043C\u0430\u0441\u0448\u0442\u0430\u0431\u0438\u0440\u0443\u0435\u0442
      \u0442\u043E\u043B\u044C\u043A\u043E \u0432\u043E\u043B\u043D\u0443; \u0431\u0430\u0437\u043E\u0432\u043E\u0435
      \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435 \u2014 100%."
    m_Metadata:
      m_Items: []
