.panel {
    -unity-background-image-tint-color: rgb(47, 47, 47);
    background-color: rgb(47, 47, 47);
    border-left-color: rgb(96, 96, 96);
    border-right-color: rgb(96, 96, 96);
    border-top-color: rgb(96, 96, 96);
    border-bottom-color: rgb(96, 96, 96);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
}

.hide {
    display: none;
}

.darkener {
    background-color: rgba(0, 0, 0, 0.69);
}

.change-button {
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(96, 96, 96);
    border-right-color: rgb(96, 96, 96);
    border-top-color: rgb(96, 96, 96);
    border-bottom-color: rgb(96, 96, 96);
    background-color: rgb(42, 42, 42);
    color: rgb(255, 255, 255);
}

.spacing-for-button {
    margin-top: 5px;
    margin-bottom: 5px;
}

/* --- Строка биндинга: ровная композиция, отступ между строками --- */
.binding-row {
    flex-direction: row;
    align-items: center;
    width: 436px;
    height: 22px;
    min-height: 22px;
    padding: 0 6px;
    margin-bottom: 2px;
    flex-shrink: 0;
}

/* Ширина задаётся динамически в ControlsUI.RecalculateActionNameColumnWidth по самому длинному тексту */
.binding-action-name {
    color: rgb(255, 255, 255);
    font-size: 9px;
    min-width: 80px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    -unity-text-align: middle-left;
}

/* Слот под инпут и кнопка Change — одинаковые размеры, ровно стыкуются */
.binding-box {
    background-color: rgb(34, 34, 34);
    border-left-color: rgb(96, 96, 96);
    border-right-color: rgb(96, 96, 96);
    border-top-color: rgb(96, 96, 96);
    border-bottom-color: rgb(96, 96, 96);
    border-width: 1px;
    border-radius: 1px;
    width: 48px;
    min-width: 48px;
    height: 18px;
    min-height: 18px;
    margin-left: 6px;
    margin-right: 4px;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
}

.binding-box .unity-label {
    font-size: 9px;
    -unity-text-align: middle-center;
}

.change-button.binding-change {
    width: 48px;
    min-width: 48px;
    height: 18px;
    min-height: 18px;
    font-size: 9px;
    padding-left: 2px;
    padding-right: 2px;
    flex-shrink: 0;
}

/* --- Окно настроек: строго 480×270 px, только пиксели --- */
.settings-window-root {
    position: absolute;
    top: 0;
    left: 0;
    width: 480px;
    height: 270px;
}

.settings-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 480px;
    height: 270px;
}

.settings-panel {
    position: absolute;
    top: 12px;
    left: 12px;
    width: 456px;
    height: 246px;
}

.settings-scroll {
    width: 454px;
    height: 244px;
    flex-shrink: 0;
}

.settings-scroll .unity-scroll-view__content-viewport {
    padding: 0;
}

.settings-scroll .unity-scroll-view__content-container {
    min-height: 0;
}

.settings-scroll .unity-scroll-view__vertical-scroller {
    width: 5px;
    min-width: 5px;
    margin-left: 1px;
    background-color: rgb(23, 23, 23);
    border-left-width: 1px;
    border-left-color: rgb(58, 58, 58);
}

.settings-scroll .unity-scroll-view__vertical-scroller .unity-scroller__low-button,
.settings-scroll .unity-scroll-view__vertical-scroller .unity-scroller__high-button {
    display: none;
}

.settings-scroll .unity-scroll-view__vertical-scroller .unity-base-slider__tracker {
    background-color: transparent;
    border-width: 0;
}

.settings-scroll .unity-scroll-view__vertical-scroller .unity-base-slider__dragger {
    width: 3px;
    min-width: 3px;
    margin-left: 1px;
    margin-right: 1px;
    background-color: rgb(105, 101, 93);
    border-width: 0;
    border-radius: 0;
}

.settings-scroll .unity-scroll-view__vertical-scroller .unity-base-slider__dragger:hover {
    background-color: rgb(150, 137, 108);
}

.settings-language-row {
    flex-direction: row;
    align-items: center;
    width: 436px;
    height: 22px;
    min-height: 22px;
    padding: 0 6px;
    flex-shrink: 0;
    overflow: visible;
}

.settings-language-label {
    color: rgb(255, 255, 255);
    font-size: 9px;
    width: 110px;
    min-width: 110px;
    max-width: 110px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.settings-display-button {
    width: 290px;
    min-width: 290px;
    height: 18px;
    min-height: 18px;
    font-size: 9px;
    flex-shrink: 0;
}

.settings-presentation-row {
    flex-direction: row;
    align-items: center;
    width: 436px;
    height: 22px;
    min-height: 22px;
    padding: 0 6px;
    flex-shrink: 0;
}

.settings-presentation-label {
    color: rgb(255, 255, 255);
    font-size: 9px;
    width: 110px;
    min-width: 110px;
    max-width: 110px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.settings-presentation-dropdown,
.settings-presentation-slider {
    height: 18px;
    min-height: 18px;
    flex-shrink: 0;
    font-size: 9px;
}

.settings-presentation-dropdown {
    width: 290px;
    min-width: 290px;
}

.settings-presentation-slider {
    min-width: 0;
    flex-grow: 1;
}

.settings-full-control {
    width: 290px;
    min-width: 290px;
    height: 18px;
    min-height: 18px;
    flex-shrink: 0;
}

.settings-select-button {
    color: rgb(226, 220, 207);
    background-color: rgb(29, 29, 29);
    border-width: 1px;
    border-color: rgb(82, 78, 70);
    border-radius: 0;
    font-size: 9px;
    padding-left: 4px;
    padding-right: 12px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    -unity-text-align: middle-left;
}

.settings-select-button:hover {
    background-color: rgb(42, 38, 31);
    border-color: rgb(133, 111, 68);
}

.settings-slider-control {
    flex-direction: row;
    align-items: center;
    width: 290px;
    min-width: 290px;
    height: 18px;
    min-height: 18px;
    flex-shrink: 0;
}

/* Компактные числовые слайдеры для референса 480x270. */
.settings-presentation-slider .unity-base-slider__input {
    height: 14px;
    min-height: 14px;
    margin-left: 0;
    margin-right: 0;
}

.settings-presentation-slider .unity-base-slider__tracker {
    height: 3px;
    min-height: 3px;
    background-color: rgb(19, 19, 19);
    border-width: 1px;
    border-color: rgb(72, 69, 63);
    border-radius: 0;
}

.settings-presentation-slider .unity-base-slider__dragger {
    width: 5px;
    min-width: 5px;
    height: 10px;
    min-height: 10px;
    background-color: rgb(177, 166, 144);
    border-width: 1px;
    border-color: rgb(61, 58, 52);
    border-radius: 0;
}

.settings-presentation-slider .unity-base-slider__dragger:hover {
    background-color: rgb(211, 187, 132);
}

.settings-slider-value {
    width: 34px;
    min-width: 34px;
    height: 14px;
    min-height: 14px;
    margin-left: 4px;
    color: rgb(226, 220, 207);
    background-color: rgb(29, 29, 29);
    border-width: 1px;
    border-color: rgb(82, 78, 70);
    padding-left: 2px;
    padding-right: 2px;
    padding-top: 0;
    padding-bottom: 0;
    margin-top: 0;
    margin-bottom: 0;
    font-size: 9px;
    overflow: hidden;
    white-space: nowrap;
    -unity-text-align: middle-center;
}

.settings-select-popup {
    display: none;
    position: absolute;
    flex-direction: column;
    background-color: rgb(29, 29, 29);
    border-width: 1px;
    border-color: rgb(82, 78, 70);
    border-radius: 0;
    padding: 1px;
    max-height: 76px;
}

.settings-select-option {
    height: 17px;
    min-height: 17px;
    flex-shrink: 0;
    color: rgb(226, 220, 207);
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
    font-size: 9px;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 0;
    padding-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    -unity-text-align: middle-left;
}

.settings-loot-filter-popup {
    height: 72px;
    min-height: 72px;
    max-height: 72px;
}

.settings-select-option:hover {
    background-color: rgb(57, 50, 37);
}

.settings-rows-container {
    flex-direction: column;
    width: 436px;
    padding: 0 6px;
    margin-top: 2px;
}
