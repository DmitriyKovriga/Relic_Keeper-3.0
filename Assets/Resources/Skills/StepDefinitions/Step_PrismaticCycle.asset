  NameEn: Prismatic Cycle
  NameRu: "\u041F\u0440\u0438\u0437\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0446\u0438\u043A\u043B"
  DescriptionEn: 'One element per cast: fire, cold, lightning. The fourth cast fires
    a prismatic burst.'
  DescriptionRu: "\u041E\u0434\u043D\u0430 \u0441\u0442\u0438\u0445\u0438\u044F \u0437\u0430
    \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435: \u043E\u0433\u043E\u043D\u044C,
    \u0445\u043E\u043B\u043E\u0434, \u043C\u043E\u043B\u043D\u0438\u044F. \u0427\u0435\u0442\u0432\u0451\u0440\u0442\u043E\u0435
    \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435 \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u0435\u0442
